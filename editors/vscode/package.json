{
  "name": "kotoba",
  "displayName": "Kotoba",
  "description": "Awai color themes and a local language server for Kotoba.",
  "version": "0.2.0",
  "publisher": "kotoba-lang",
  "main": "./extension.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kotoba-lang/grammar"
  },
  "homepage": "https://kotoba-lang.org/#docs",
  "bugs": {
    "url": "https://github.com/kotoba-lang/grammar/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "activationEvents": [
    "onLanguage:kotoba"
  ],
  "dependencies": {
    "vscode-languageclient": "10.1.2",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "bin": {
    "kotoba-lsp": "./server/server.js"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kotoba",
    "language",
    "language-server",
    "syntax-highlighting",
    "color-theme",
    "textmate",
    "capability-security"
  ],
  "galleryBanner": {
    "color": "#1e50a2",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "kotoba",
        "aliases": [
          "Kotoba",
          "kotoba"
        ],
        "extensions": [
          ".kotoba"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kotoba",
        "scopeName": "source.kotoba",
        "path": "./syntaxes/kotoba.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Kotoba Awai Light",
        "uiTheme": "vs",
        "path": "./themes/kotoba-awai-light-color-theme.json"
      },
      {
        "label": "Kotoba Awai Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kotoba-awai-dark-color-theme.json"
      }
    ]
  }
}
