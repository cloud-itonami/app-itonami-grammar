#!/usr/bin/env kbb
;; Generate `src/kotoba/grammar/embedded.cljk` from
;; `resources/kotoba/lang/guest-grammar.edn`.
;;
;;   kbb --backend sci tools/gen-embedded.cljk           # write
;;   kbb --backend sci tools/gen-embedded.cljk --check   # exit 1 if stale, 2 if it cannot tell
;;
;; ## Why embed at all
;;
;; There is no portable `io/resource`. The obvious ClojureScript substitute —
;; reading `resources/<path>` relative to the PROCESS's working directory — is
;; right only while this library is the root project and wrong the moment it is
;; a dependency. Measured elsewhere in this workspace on 2026-08-18: with
;; `kotoba-lang/technology` on that pattern, `kotoba.iso3166`'s suite under nbb
;; produced 159 errors, all of them the registry coming back nil because nbb's
;; cwd was iso3166's root and not technology's.
;;
;; The EDN file stays the source of truth and the thing a human edits — it is
;; vendored from kotoba-lang/lang/guest-grammar.edn and re-vendored by a
;; separate sync. The generated namespace is a projection of it, checked by
;; `--check`, and it is what the library actually reads. So there is no runtime
;; file access, no cwd assumption, and no classpath assumption either.
;;
;; ## The check is the failure mode that replaced the old one
;;
;; The loader this replaced tried three locations and fell back to a stub
;; catalog marked `:status :missing` — a real failure mode, honestly handled.
;; With the data compiled in there is nothing left to fail to read, so that
;; discipline is gone with the path it guarded. What CAN go wrong now is the
;; projection drifting from the EDN, so that is what is guarded: `--check`
;; here, and `the-embedded-catalog-matches-the-edn` in the suite, which fails
;; rather than passes when it cannot read the EDN.
(require '["node:fs" :as fs]
         '[cljs.reader :as reader]
         '[clojure.string :as cstr]
         '[kotoba.lang.text :as str])

(def edn-path "resources/kotoba/lang/guest-grammar.edn")
(def out-path "src/kotoba/grammar/embedded.cljk")
(def kotoba-out-path "src/kotoba/grammar/embedded_native.kotoba")

(defn- packed-names [items]
  (str "|" (cstr/join "|" (sort (map name items))) "|"))

(defn- membership-function [function-name field]
  (str "(defn " function-name " [head :string] :bool\n"
       "  (>= (string-index-of " field "\n"
       "                       (string-concat \"|\" (string-concat head \"|\"))) 0))\n"))

(defn- render-kotoba [txt]
  (let [catalog (reader/read-string txt)
        admitted (concat (:core-special-forms catalog)
                         (:arithmetic catalog)
                         (:comparisons catalog)
                         (:predicates catalog)
                         (:admitted-builtins catalog)
                         (:string-head-host-ops catalog)
                         (keys (:sugar catalog)))
        source
        (str ";; GENERATED FROM resources/kotoba/lang/guest-grammar.edn.\n"
             ";; Regenerate and check with tools/gen-embedded.cljk.\n"
             ";; This compact guest projection keeps the canonical EDN as the\n"
             ";; only editable source; host consumers use embedded.cljk.\n"
             "(ns kotoba.grammar.embedded-native\n"
             "  {:kotoba/export [forbidden-head? admitted-head? string-host-op?\n"
             "                   data-host-op? raw-memory-op? diagnostic-hint\n"
             "                   strict-default?]} )\n\n"
             "(def ^:private forbidden-heads " (pr-str (packed-names (:forbidden-heads catalog))) ")\n"
             "(def ^:private admitted-heads " (pr-str (packed-names admitted)) ")\n"
             "(def ^:private string-host-ops " (pr-str (packed-names (:string-head-host-ops catalog))) ")\n"
             "(def ^:private data-host-ops " (pr-str (packed-names (:data-head-host-ops catalog))) ")\n"
             "(def ^:private raw-memory-ops " (pr-str (packed-names (:raw-memory-ops catalog))) ")\n\n"
             (membership-function "forbidden-head?" "forbidden-heads")
             (membership-function "admitted-head?" "admitted-heads")
             (membership-function "string-host-op?" "string-host-ops")
             (membership-function "data-host-op?" "data-host-ops")
             (membership-function "raw-memory-op?" "raw-memory-ops")
             "(defn diagnostic-hint [head :string] :string\n  "
             (reduce (fn [fallback [key hint]]
                       (str "(if (string=? head " (pr-str key) ") "
                            (pr-str hint) " " fallback ")"))
                     "\"\""
                     (reverse (sort-by key (:diagnostic-hints catalog))))
             ")\n\n"
             "(defn strict-default? [] :bool "
             (if (get-in catalog [:strict-grammar :default]) "true" "false") ")\n")]
    source))

(defn- render [txt]
  (str ";; GENERATED — do not edit. Source: " edn-path "\n"
       ";; Regenerate: kbb --backend sci tools/gen-embedded.cljk   Check: --check\n"
       ";;\n"
       ";; This is a projection of the EDN, not a second source of truth. If you\n"
       ";; edit it by hand `--check` fails, which is the whole point: two copies\n"
       ";; that can silently disagree are worse than one copy in the wrong format.\n"
       "(ns kotoba.grammar.embedded {:kotoba/export [catalog]})\n\n"
       ";; Quoted, not evaluated. Unlike a registry of strings and keywords this\n"
       ";; catalog is FULL of bare symbols — `try`, `catch`, `def` — because it\n"
       ";; is a list of forbidden and admitted call HEADS. Spliced in unquoted\n"
       ";; the compiler reads them as code and the namespace does not load:\n"
       ";; measured 2026-08-18, \"Unable to resolve symbol: try in this context\".\n"
       "(def catalog\n"
       "  (quote\n"
       "   " (str/trim txt) "))\n"))

(let [args (vec *command-line-args*)
      check? (some #{"--check"} args)]
  (if-not (fs/existsSync edn-path)
    (do (println "SCANNED\t0")
        (println "Refusing to answer: no" edn-path)
        (set! (.-exitCode js/process) 2))
    (let [txt (.toString (fs/readFileSync edn-path))
          want (render txt)
          want-kotoba (render-kotoba txt)
          have (when (fs/existsSync out-path) (.toString (fs/readFileSync out-path)))
          have-kotoba (when (fs/existsSync kotoba-out-path)
                        (.toString (fs/readFileSync kotoba-out-path)))]
      (println "SCANNED\t1")
      (cond
        (not check?) (do (fs/writeFileSync out-path want)
                         (fs/writeFileSync kotoba-out-path want-kotoba)
                         (println "wrote" out-path (count want) "bytes")
                         (println "wrote" kotoba-out-path (count want-kotoba) "bytes"))
        (and (= want have) (= want-kotoba have-kotoba))
        (do (println "OK" out-path "matches" edn-path)
            (println "OK" kotoba-out-path "matches projection of" edn-path))
        :else (do (println "STALE generated grammar source does not match" edn-path
                           "— run: kbb --backend sci tools/gen-embedded.cljk")
                  (set! (.-exitCode js/process) 1))))))
